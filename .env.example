# Supabase — preencha apenas no ambiente local ou no cofre do executor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Meta / WhatsApp — somente no processo local e nunca com valores reais no Git.
META_GRAPH_API_VERSION=
META_APP_ID=
META_WABA_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_TEMPLATE_NAME=cbn_ctps_simulacao_v1
META_TEMPLATE_LANGUAGE=pt_BR

# Chatwoot / n8n — use somente no gerenciador de credenciais do n8n.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_ACCESS_TOKEN=

# SEGURANCA:
# - nunca envie chaves ou DATABASE_URL ao GitHub;
# - SUPABASE_SERVICE_ROLE_KEY e somente para backend confiavel;
# - Appsmith no navegador nunca deve receber service_role;
# - n8n deve usar o gerenciador de credenciais, nao variaveis expostas no fluxo;
# - sessoes Telegram, tokens e chaves privadas ficam no cofre, nunca no banco operacional.

ARG CBN_BASE=cbn/chatwoot:4.16.2-cbn-leads-labels-20261019
FROM ${CBN_BASE} AS baseline
FROM node:24-alpine AS assets
WORKDIR /app
COPY --from=baseline /app /app
RUN apk add --no-cache python3 git && corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY patch-editor.py /tmp/patch-editor.py
COPY whatsappEditor.js /app/app/javascript/dashboard/helper/whatsappEditor.js
COPY markdown-to-whatsapp.mjs /app/scripts/cbn-whatsapp-formatting/markdown-to-whatsapp.mjs
RUN python3 /tmp/patch-editor.py && pnpm install --frozen-lockfile --ignore-scripts
RUN node -e 'const {createRequire}=require("node:module");createRequire(require.resolve("vite"))("esbuild").buildSync({entryPoints:["scripts/cbn-whatsapp-formatting/markdown-to-whatsapp.mjs"],bundle:true,platform:"node",format:"cjs",outfile:"cbn-whatsapp-formatting.cjs"})'
ENV NODE_OPTIONS=--max-old-space-size=2560 RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1
RUN pnpm exec vite build --mode production
FROM baseline
COPY --from=assets /app/public/vite /app/public/vite
COPY --from=assets /app/app/javascript /app/app/javascript
COPY --from=assets /app/cbn-whatsapp-formatting.cjs /app/cbn-whatsapp-formatting.cjs
COPY --from=baseline /app/public/vite /tmp/cbn-old-vite
RUN ruby -rjson -e 'm=JSON.parse(File.read("/tmp/cbn-old-vite/.vite/manifest.json")); old=m.values.find{|e|e["isEntry"] && e["file"].start_with?("assets/dashboard-")}; n=JSON.parse(File.read("/app/public/vite/.vite/manifest.json")); cur=n.values.find{|e|e["isEntry"] && e["file"].start_with?("assets/dashboard-")}; File.open("/app/public/vite/"+cur["css"].first,"a"){|f| f.write("\n"+File.read("/tmp/cbn-old-vite/"+old["css"].first))}'

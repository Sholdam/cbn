FROM cbn/chatwoot:4.16.2-cbn-date-copy-20261020 AS baseline
FROM node:24-alpine AS assets
WORKDIR /app
COPY --from=baseline /app /app
RUN apk add --no-cache python3 git && corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY patch-secretaria-label.py /tmp/patch-secretaria-label.py
RUN python3 /tmp/patch-secretaria-label.py && pnpm install --frozen-lockfile --ignore-scripts
ENV NODE_OPTIONS=--max-old-space-size=2560 RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1
RUN pnpm exec vite build --mode production
FROM baseline
COPY --from=assets /app/public/vite /app/public/vite
COPY --from=assets /app/app/javascript/dashboard/i18n/locale/pt_BR/chatlist.json /app/app/javascript/dashboard/i18n/locale/pt_BR/chatlist.json
COPY --from=assets /app/app/javascript/dashboard/i18n/locale/pt_BR/conversation.json /app/app/javascript/dashboard/i18n/locale/pt_BR/conversation.json
COPY --from=assets /app/app/javascript/dashboard/i18n/locale/pt_BR/automation.json /app/app/javascript/dashboard/i18n/locale/pt_BR/automation.json
COPY --from=assets /app/app/javascript/dashboard/i18n/locale/pt_BR/report.json /app/app/javascript/dashboard/i18n/locale/pt_BR/report.json
COPY --from=assets /app/vite.config.ts /app/vite.config.ts
COPY --from=baseline /app/public/vite /tmp/cbn-old-vite
RUN ruby -rjson -e 'm=JSON.parse(File.read("/tmp/cbn-old-vite/.vite/manifest.json")); old=m.values.find{|e|e["isEntry"] && e["file"].start_with?("assets/dashboard-")}; n=JSON.parse(File.read("/app/public/vite/.vite/manifest.json")); cur=n.values.find{|e|e["isEntry"] && e["file"].start_with?("assets/dashboard-")}; File.open("/app/public/vite/"+cur["css"].first,"a"){|f|f.write("\n"+File.read("/tmp/cbn-old-vite/"+old["css"].first))}'

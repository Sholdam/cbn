{
  "name": "cbn-telegram-gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Gateway interno e serializado para consultas CLT via Telegram MTProto.",
  "scripts": {
    "start": "node src/server.js",
    "auth": "node src/auth.js",
    "check": "node src/check-session.js",
    "idempotency:first": "node src/idempotency-test.js first",
    "idempotency:retry": "node src/idempotency-test.js retry",
    "idempotency:reset": "node src/idempotency-test.js reset",
    "test": "node --test --test-isolation=none test/callback.test.js test/clt-flow.test.js test/clt-offers.test.js test/operation-queue.test.js test/validation.test.js",
    "test:focused": "node --test --test-isolation=none test/clt-flow.test.js test/validation.test.js test/operation-queue.test.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "input": "1.0.1",
    "telegram": "2.26.22"
  },
  "engines": {
    "node": ">=20"
  }
}
